# ==============================================================================
# ZCO-Hunter Environment Variables Template
# Copy this file to .env and configure your local settings.
# ==============================================================================

# Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram admin allow-list (comma-separated numeric chat IDs).
# The bot refuses every command/button from any other chat, and exits at
# startup when this list is empty. Get your numeric ID from @userinfobot.
TELEGRAM_ADMIN_CHAT_IDS=

# Local Web Dashboard Security Configuration
# Default to 127.0.0.1 for local network safety (prevents open access on campus/shared Wi-Fi)
HOST=127.0.0.1
PORT=8080

# Dashboard auth token. Leave blank to auto-generate one at first start
# (stored in data/dashboard_token.txt, chmod 600). Set explicitly for remote access.
# Access requires the HttpOnly session cookie obtained by opening /?token=<token>,
# or the X-Dashboard-Token header for API clients.
DASHBOARD_AUTH_TOKEN=

# Explicit opt-in for unattended form submission (default: disabled).
# Keep 0 unless you understand that real applications may be irreversible.
# Even when enabled, only confirmed submissions are marked APPLIED_AUTOMATICALLY.
ZCO_AUTO_SUBMIT=0

# Supervisor log rotation & restart policy
ZCO_LOG_MAX_BYTES=10485760
ZCO_LOG_BACKUPS=3
ZCO_MAX_RESTARTS=5
